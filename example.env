# RAG Notion App - Example Environment Variables

# Google Gemini API Key
# Get this from https://ai.google.dev/
GOOGLE_API_KEY=your_gemini_api_key_here

# Notion API Key
# Get this from https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here

# Comma-separated list of Notion page IDs or URLs to load
# Example: a1b2c3d4e5f6,g7h8i9j0k1l2
NOTION_PAGE_IDS=

# Model settings
TEMPERATURE=0.7

# ChromaDB Configuration
CHROMA_SERVER_HOST=0.0.0.0
CHROMA_SERVER_PORT=8000

# Embedding Configuration
EMBEDDING_MODEL=all-mpnet-base-v2

# Application Settings
DEBUG=False
LOG_LEVEL=INFO

# Vector Database Path
VECTOR_DB_PATH=./chroma_db 